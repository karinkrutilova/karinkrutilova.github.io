---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import settings from '../content/settings.json';
import { getWorks } from '../lib/works';
const works = await getWorks();
const base = import.meta.env.BASE_URL;
---
<Base title={settings.heading}>
  <section class="hero">
    <div class="hero-identity">
      <h1>{settings.name}</h1>
    </div>
    <div class="hero-bio"><p>{settings.intro}</p></div>
  </section>
  <section class="works" id="works">
    <h2 class="section-heading">{settings.heading}</h2>
    <ul class="gallery" aria-label="Artworks">
      {works.map((work) => (
        <li>
          <a class="work-link" href={`${base}works/${work.id}/`}>
            <span class="work-frame">
              <Image src={work.data.image} alt={work.data.imageAlt}
                widths={[400, 800, 1200]} sizes="(max-width: 620px) 90vw, (max-width: 950px) 45vw, 400px"
                format="webp" loading="lazy" />
            </span>
            {(settings.showTitle || settings.showYear) && (
              <div class="work-caption">{settings.showTitle && <h2>{work.data.title}</h2>}{settings.showYear && <span>{work.data.year}</span>}</div>
            )}
            {settings.showMedium && (work.data.credit || work.data.medium) && <p class="work-medium">{work.data.credit || work.data.medium}</p>}
          </a>
        </li>
      ))}
    </ul>
    {works.length === 0 && <p class="collection-note">New artwork is on its way.</p>}
    {works.some(work => work.data.source) && <p class="collection-note">Sample collection of public-domain artworks.</p>}
  </section>
</Base>
