---
import Base from '../layouts/Base.astro';
---

<Base title="Projects" description="University projects by Karin Krútilová.">
  <section class="projects-page" aria-labelledby="projects-title">
    <header class="projects-intro">
      <h1 id="projects-title">Projects</h1>
      <p>
        A space for university projects, research-led experiments, reports, and
        abstracts.
      </p>
    </header>

    <section class="projects-empty" aria-labelledby="projects-coming-soon">
      <p class="projects-empty-label">Archive in preparation</p>
      <div class="projects-empty-copy">
        <h2 id="projects-coming-soon">Projects will be added soon.</h2>
        <p>
          Future entries can pair a short abstract with selected images and a
          link to the complete report.
        </p>
      </div>
    </section>
  </section>
</Base>
