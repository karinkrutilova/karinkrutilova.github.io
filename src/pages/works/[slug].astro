---
import { Image } from 'astro:assets';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import settings from '../../content/settings.json';
import { pickDetailCrops } from '../../lib/detail-crops.mjs';
export async function getStaticPaths() {
  return (await getCollection('works')).map(work => ({ params: { slug: work.id }, props: { work } }));
}
interface Props { work: CollectionEntry<'works'> }
const { work } = Astro.props;
const { Content } = await render(work);
const { title, year, medium, dimensions, image, imageAlt, tags, credit, source } = work.data;
// Close-ups are chosen at build time from the busiest regions of the image; switch off in Site text → settings.
const details = settings.showDetails ? await pickDetailCrops((image as { fsPath?: string }).fsPath ?? image.src) : [];
---
<Base title={title} description={`${title}, ${year}${medium ? ` · ${medium}` : ''}`}>
  <a class="back-link" href={import.meta.env.BASE_URL}><span aria-hidden="true">←</span> All works</a>
  <article class="work-detail">
    <figure class="detail-image">
      <Image src={image} alt={imageAlt} widths={[600, 1000, 1600]} sizes="(max-width: 620px) 90vw, 60vw" format="webp" loading="eager" />
    </figure>
    <div class="work-info">
      {settings.showTitle
        ? <><h1>{title}</h1>{settings.showYear && <p class="work-year">{year}</p>}</>
        : settings.showYear ? <h1>{year}</h1> : <h1 class="visually-hidden">{title}</h1>}
      {settings.showMedium && (medium || dimensions) && (
        <dl>
          {medium && <><dt>Medium</dt><dd>{medium}</dd></>}
          {dimensions && <><dt>Dimensions</dt><dd>{dimensions}</dd></>}
        </dl>
      )}
      {settings.showDescription && <div class="prose"><Content /></div>}
      {settings.showTags && tags.length > 0 && <ul class="tags" aria-label="Tags">{tags.map(tag => <li>{tag}</li>)}</ul>}
      {settings.showMedium && credit && <p class="credit">{credit}{source && <> · <a href={source}>View museum record ↗</a></>}</p>}
    </div>
  </article>
  {details.length > 0 && (
    <section class="details" aria-label="Close-ups">
      <h2>Details</h2>
      <ul class="detail-crops">
        {details.map((crop, index) => (
          <li class="crop">
            <Image src={image} alt={`${title}, close-up ${index + 1}`} widths={[1600]} sizes="(max-width: 620px) 90vw, 30vw" format="webp" loading="lazy"
              style={`width:${(100 / crop.size).toFixed(2)}%;left:${(-100 * crop.x / crop.size).toFixed(2)}%;top:${(-100 * crop.y / crop.size).toFixed(2)}%`} />
          </li>
        ))}
      </ul>
    </section>
  )}
</Base>
