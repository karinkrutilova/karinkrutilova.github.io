---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import settings from '../../content/settings.json';
import { getWorks, type Work } from '../../lib/works';
export async function getStaticPaths() {
  const works = await getWorks();
  return works.map((work, i) => ({ params: { slug: work.id }, props: { work, prev: works[i - 1], next: works[i + 1] } }));
}
interface Props { work: Work; prev?: Work; next?: Work }
const { work, prev, next } = Astro.props;
const Content = work.entry ? (await render(work.entry)).Content : undefined;
const { title, year, medium, dimensions, image, imageAlt, tags, credit, source } = work.data;
const base = import.meta.env.BASE_URL;
---
<Base title={title} description={[title, year, medium].filter(Boolean).join(' · ')}>
  <a class="back-link" href={base}>All artwork</a>
  <article class="work-detail">
    <figure class="detail-image">
      <Image src={image} alt={imageAlt} widths={[800, 1600]} sizes="(max-width: 950px) 90vw, 800px" format="webp" loading="eager" />
    </figure>
    <div class="work-info">
      {settings.showTitle
        ? <><h1>{title}</h1>{settings.showYear && year && <p class="work-year">{year}</p>}</>
        : settings.showYear && year ? <h1>{year}</h1> : <h1 class="visually-hidden">{title}</h1>}
      {settings.showMedium && (medium || dimensions) && (
        <dl>
          {medium && <><dt>Medium</dt><dd>{medium}</dd></>}
          {dimensions && <><dt>Dimensions</dt><dd>{dimensions}</dd></>}
        </dl>
      )}
      {settings.showDescription && Content && <div class="prose"><Content /></div>}
      {settings.showTags && tags.length > 0 && <ul class="tags" aria-label="Tags">{tags.map(tag => <li>{tag}</li>)}</ul>}
      {settings.showMedium && credit && <p class="credit">{credit}{source && <> · <a href={source}>View museum record</a></>}</p>}
    </div>
  </article>
  {(prev || next) && (
    <nav class="siblings" aria-label="Other artwork">
      {prev && (
        <a href={`${base}works/${prev.id}/`}>
          <Image src={prev.data.image} alt={prev.data.imageAlt} widths={[160]} sizes="80px" format="webp" loading="lazy" />
          <span>Previous{settings.showTitle && <strong>{prev.data.title}</strong>}</span>
        </a>
      )}
      {next && (
        <a class="next" href={`${base}works/${next.id}/`}>
          <span>Next{settings.showTitle && <strong>{next.data.title}</strong>}</span>
          <Image src={next.data.image} alt={next.data.imageAlt} widths={[160]} sizes="80px" format="webp" loading="lazy" />
        </a>
      )}
    </nav>
  )}
</Base>
