---
import Base from '../layouts/Base.astro';
import settings from '../content/settings.json';
---

<Base title="Contact" description="Contact Karin Krútilová for illustration work and collaborations.">
  <section class="contact-page" aria-labelledby="contact-title">
    <header class="contact-intro">
      <h1 id="contact-title">Contact</h1>
      <p>Have a project in mind? I’m available for illustration commissions, collaborations, and freelance projects.</p>
    </header>

    <section class="contact-section" aria-labelledby="contact-details-title">
      <p class="contact-label">Email</p>
      <div class="contact-copy">
        <h2 id="contact-details-title">Tell me about your idea.</h2>
        <p>A short description, intended use, timeline, and budget are helpful if you already know them.</p>
        <a class="contact-email" href={`mailto:${settings.email}?subject=Project%20enquiry`}>
          <span>{settings.email}</span>
          <span class="contact-arrow" aria-hidden="true">↗</span>
        </a>
      </div>
    </section>
  </section>
</Base>
