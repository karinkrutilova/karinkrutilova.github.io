---
import Base from '../layouts/Base.astro';
import settings from '../content/settings.json';
---

<Base title="Contact" description="Contact Karin Krútilová for illustration work and collaborations.">
  <section class="projects-page" aria-labelledby="contact-title">
    <header class="projects-intro">
      <h1 id="contact-title">Contact</h1>
      <p>For commissions, collaborations, and project enquiries.</p>
    </header>

    <section class="projects-empty" aria-labelledby="contact-details-title">
      <p class="projects-empty-label">Get in touch</p>
      <div class="projects-empty-copy">
        <h2 id="contact-details-title">Contact details</h2>
        {settings.email && <p><a href={`mailto:${settings.email}`}>{settings.email}</a></p>}
        {settings.instagram && <p><a href={settings.instagram}>Instagram</a></p>}
        {!settings.email && !settings.instagram && <p>Contact details will be added soon.</p>}
      </div>
    </section>
  </section>
</Base>
