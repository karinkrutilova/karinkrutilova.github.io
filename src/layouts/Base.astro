---
import '../styles/global.css';
import settings from '../content/settings.json';
interface Props { title: string; description?: string }
const { title, description = settings.intro } = Astro.props;
const base = import.meta.env.BASE_URL;
const projectsPath = `${base}projects/`;
const contactPath = `${base}contact/`;
const isProjects = Astro.url.pathname.startsWith(projectsPath);
const isContact = Astro.url.pathname.startsWith(contactPath);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#000000" />
    <title>{title} · {settings.name}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@300;400;500&display=swap" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header wrap">
      <a class="wordmark" href={base}>
        <span>K.K. — freelance illustration</span>
        <svg class="wordmark-icon" viewBox="0 0 38 18" aria-hidden="true" focusable="false">
          <path d="M1 15.5c2.4-2.2 4.6 1.1 7.3-.7" />
          <path d="M7.8 14.7 12 5h6v8.1l-9.5 2.6-.7-1Z" />
          <path d="m8.5 15.7 5.7-5.8" />
          <circle cx="14.2" cy="9.8" r="1" />
          <path d="M18 5h14.8a2.5 2.5 0 0 1 0 8.1H18M28.7 5V2.3h4.1" />
        </svg>
      </a>
      <nav aria-label="Main navigation">
        <a href={base} aria-current={!isProjects && !isContact ? 'page' : undefined}>Artwork</a>
        <a href={projectsPath} aria-current={isProjects ? 'page' : undefined}>Projects</a>
        <a href={contactPath} aria-current={isContact ? 'page' : undefined}>Contact</a>
      </nav>
    </header>
    <main id="main" class="wrap"><slot /></main>
    <footer class="site-footer wrap">
      <span>{settings.name}</span>
      <div>
        {settings.instagram && <a href={settings.instagram}>Instagram</a>}
        {settings.email && <a href={`mailto:${settings.email}`}>Email</a>}
        <a class="admin" href={`${base}admin/`}>Edit portfolio</a>
      </div>
    </footer>
  </body>
</html>
